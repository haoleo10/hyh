                <div class="title">同步状态</div>
                <div class="left_top">
                    <div class="left_top_main">
                        <div class="left_main_circle">
                            <p class="counter-value circle_num1">初始化</p>
                            <span class="span_font">同步中<br /></span>
                        </div>
                        <div class="left_main_circle">
                            <p class="counter-value circle_num2">CEX初始化</p>
                            <span class="span_font">同步完成<br /></span>
                        </div>
                        <div class="left_main_circle" style="margin-top:1vw;">
                            <p class="counter-value circle_num3">ABP初始化</p>
                            <span class="span_font">同步完成<br /></span>
                        </div>
                        <div class="left_main_circle">
                            <p class="counter-value circle_num4">AHP初始化</p>
                            <span class="span_font">同步完成<br /></span>
                        </div>
                    </div>
                </div>

