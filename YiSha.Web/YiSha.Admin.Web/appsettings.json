    "WebApiIP": "127.0.0.1", //WebApi地址
    "WebApiPort": "5001", //WebApi端口

    "StartCompute": "HyhSZLSSTART", //开始反算
    "StopCompute": "HyhSZLSSTOP", //停止反算

    "InitializationStarted": "HYH_AA5_HyhDCSSYNSTART", //开始初始化
    "InitializationPause": "HYH_AA5_HyhDCSSYNPAUSE", //初始化暂停
    "InitializationTermination": "HYH_AA5_HyhDCSSYNSTOP", //初始化终止

    "LoadingIC": "HYH_AA5_HyhDCSSYNLOADIC", //加载IC
    "DataSynchronization": "HYH_AA5_HyhDCSSYNDATA", //数据同步

