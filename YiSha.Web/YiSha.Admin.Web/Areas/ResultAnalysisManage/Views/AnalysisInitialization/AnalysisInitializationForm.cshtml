@{
    Layout = "~/Views/Shared/_FormWhite.cshtml";
}

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
    }

    body {
        background: linear-gradient(135deg, #f5f7fa 0%, #e4edf9 100%);
        min-height: 100vh;
        padding: 40px 20px;
        color: #333;
    }

    .container {
        max-width: 800px;
        margin: 0 auto;
    }

    .header {
        text-align: center;
        margin-bottom: 40px;
        padding: 20px;
        background: rgba(255, 255, 255, 0.7);
        border-radius: 16px;
        box-shadow: 0 8px 20px rgba(18, 84, 136, 0.1);
        backdrop-filter: blur(10px);
    }

        .header h1 {
            font-size: 32px;
            color: #1a2980;
            margin-bottom: 10px;
            font-weight: 700;
        }

        .header .date-info {
            font-size: 18px;
            color: #6c757d;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 15px;
            flex-wrap: wrap;
        }

    .date-info .current-time {
        background: linear-gradient(135deg, #1a2980 0%, #26d0ce 100%);
        color: white;
        padding: 6px 15px;
        border-radius: 20px;
        font-weight: 500;
    }

    .ibox {
        background: white;
        border-radius: 16px;
        box-shadow: 0 12px 30px rgba(18, 84, 136, 0.15);
        overflow: hidden;
    }

    #ibox-content {
        padding: 30px;
    }

    .vertical-container {
        position: relative;
        padding: 20px 0;
    }

        .vertical-container:before {
            content: '';
            position: absolute;
            top: 0;
            bottom: 0;
            left: 70px;
            width: 4px;
            background: linear-gradient(to bottom, #1a2980, #26d0ce, #0072ff, #00c6ff, #0093E9, #80D0C7, #ff416c, #ff4b2b, #00b09b, #96c93d);
            border-radius: 2px;
            z-index: 0;
        }

    .vertical-timeline-block {
        display: flex;
        position: relative;
        margin-bottom: 40px;
        transition: all 0.3s cubic-bezier(.25,.8,.25,1);
        z-index: 1;
    }

        .vertical-timeline-block:hover {
            transform: translateY(-5px);
        }

    .vertical-timeline-icon {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 0 0 4px white, 0 6px 15px rgba(0,0,0,0.15);
        position: relative;
        z-index: 2;
        transition: transform 0.3s;
    }

        .vertical-timeline-icon i {
            font-size: 24px;
            color: white;
        }

    .vertical-timeline-content {
        flex: 1;
        margin-left: 30px;
        border-radius: 16px;
        background: linear-gradient(145deg, #ffffff, #f8f9fa);
        box-shadow: 0 6px 20px rgba(18,84,136,0.1);
        border: 1px solid rgba(230, 236, 245, 0.8);
        padding: 25px;
        position: relative;
        overflow: hidden;
    }

        .vertical-timeline-content:before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 6px;
            height: 100%;
        }

    .system-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        flex-wrap: wrap;
        gap: 15px;
    }

    .system-title {
        font-size: 24px;
        margin: 0;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .status-indicator {
        display: inline-flex;
        align-items: center;
        font-size: 16px;
        padding: 8px 18px;
        border-radius: 20px;
        font-weight: 500;
    }

    .syncing {
        background: rgba(40, 167, 69, 0.12);
        color: #28a745;
    }

    .success {
        background: rgba(40, 167, 69, 0.15);
        color: #28a745;
    }

    .failed {
        background: rgba(220, 53, 69, 0.15);
        color: #dc3545;
    }

    .system-details {
        color: #6c757d;
        line-height: 1.6;
    }

        .system-details p {
            margin: 8px 0;
            display: flex;
            align-items: center;
        }

        .system-details i {
            margin-right: 10px;
            width: 20px;
            text-align: center;
        }

    .error-details {
        background: rgba(220, 53, 69, 0.08);
        border-left: 3px solid #dc3545;
        padding: 12px 15px;
        margin-top: 15px;
        border-radius: 0 8px 8px 0;
        color: #721c24;
    }

    .success-badge {
        position: absolute;
        top: 20px;
        right: 20px;
        font-size: 48px;
        color: rgba(40, 167, 69, 0.15);
        z-index: 0;
    }

    .warning-badge {
        position: absolute;
        top: 20px;
        right: 20px;
        font-size: 48px;
        color: rgba(220, 53, 69, 0.1);
        z-index: 0;
    }

    .pulse {
        animation: pulse 2s infinite;
    }

    .loading-dots::after {
        content: '...';
        animation: dot-pulse 1.5s infinite;
    }

    .navy-bg {
        background: linear-gradient(135deg, #1a2980 0%, #26d0ce 100%);
    }

    .blue-bg {
        background: linear-gradient(135deg, #0072ff 0%, #00c6ff 100%);
    }

    .lazur-bg {
        background: linear-gradient(135deg, #0093E9 0%, #80D0C7 100%);
    }

    .purple-bg {
        background: linear-gradient(135deg, #7b4397 0%, #dc2430 100%);
    }

    .green-bg {
        background: linear-gradient(135deg, #00b09b 0%, #96c93d 100%);
    }

    .btn {
        display: inline-block;
        padding: 8px 16px;
        border-radius: 5px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s;
        margin-top: 12px;
    }

    .retry-btn {
        background: #dc3545;
        color: white;
        border: none;
    }

        .retry-btn:hover {
            background: #bd2130;
            transform: translateY(-2px);
        }

    .view-btn {
        background: #007bff;
        color: white;
        border: none;
    }

        .view-btn:hover {
            background: #0069d9;
            transform: translateY(-2px);
        }

    .fadeInUp {
        animation: fadeInUp 0.6s ease-out;
    }

    .status-count {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }

    .status-item {
        display: flex;
        align-items: center;
        padding: 8px 16px;
        border-radius: 50px;
        font-size: 14px;
        font-weight: 500;
    }

    .status-syncing {
        background: rgba(40, 167, 69, 0.15);
        color: #28a745;
    }

    .status-success {
        background: rgba(40, 167, 69, 0.15);
        color: #28a745;
    }

    .status-failed {
        background: rgba(220, 53, 69, 0.15);
        color: #dc3545;
    }

    /* 新增居中容器 */
    .sync-container {
        display: flex;
        justify-content: center;
        margin-top: 20px;
        width: 100%;
    }

    /* 按钮组容器 */
    .sync-controls {
        display: flex;
        gap: 15px;
        justify-content: center;
        background: rgba(255,255,255,0.1);
        padding: 12px 25px;
        border-radius: 50px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

    /* 按钮通用样式 */
    .sync-btn {
        padding: 10px 20px;
        border-radius: 30px;
        border: none;
        cursor: pointer;
        transition: all 0.3s ease;
        font-weight: bold;
        letter-spacing: 1px;
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 120px;
        justify-content: center;
    }

    /* 开始按钮 */
    .start-sync {
        background: linear-gradient(145deg, #4CAF50, #2E7D32);
        color: white;
        box-shadow: 0 4px 8px rgba(76, 175, 80, 0.3);
    }

    /* 停止按钮 */
    .stop-sync {
        background: linear-gradient(145deg, #f44336, #c62828);
        color: white;
        box-shadow: 0 4px 8px rgba(244, 67, 54, 0.3);
    }

    /* 继续按钮 */
    .resume-sync {
        background: linear-gradient(145deg, #2196F3, #0d47a1);
        color: white;
        box-shadow: 0 4px 8px rgba(33, 150, 243, 0.3);
    }

    /* 悬停效果 */
    .sync-btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 6px 12px rgba(0,0,0,0.15);
    }

    .sync-btn:active {
        transform: translateY(1px);
    }
</style>

<div class="container">
    <div class="header fadeInUp">
        <h1>系统同步状态监控</h1>
        <div class="date-info">
            <span class="current-time">
                <i class="fa fa-calendar"></i> 2025年7月1日
            </span>
            <span><i class="fa fa-clock-o"></i> 当前时间: 14:54</span>
            <span><i class="fa fa-calendar-check-o"></i> 农历乙巳蛇年六月初七</span>
        </div>

        <!-- 居中显示的按钮容器 -->
        <div class="sync-container">
            <div class="sync-controls">
                <button class="sync-btn start-sync">
                    <i class="fa fa-play"></i> 开始同步
                </button>
                <button class="sync-btn stop-sync">
                    <i class="fa fa-stop"></i> 停止同步
                </button>
                <button class="sync-btn resume-sync">
                    <i class="fa fa-forward"></i> 差异同步投入/退出
                </button>
            </div>
        </div>
    </div>
     
    <div class="status-count">
        <div class="status-item status-syncing">
            <i class="fa fa-refresh fa-spin"></i> 同步中: 3 个系统
        </div>
        <div class="status-item status-success">
            <i class="fa fa-check-circle"></i> 同步成功: 1 个系统
        </div>
        <div class="status-item status-failed">
            <i class="fa fa-exclamation-circle"></i> 同步失败: 1 个系统
        </div>
    </div>

    <div class="ibox">
        <div id="ibox-content">
            <div id="vertical-timeline" class="vertical-container light-timeline">
                <!-- AHP 系统 -->
                <div class="vertical-timeline-block fadeInUp">
                    <div class="vertical-timeline-icon navy-bg pulse">
                        <i class="fa fa-briefcase"></i>
                    </div>
                    <div class="vertical-timeline-content">
                        <div class="system-header">
                            <h1 class="system-title">
                                <i class="fa fa-database"></i>
                                AHP 系统
                            </h1>
                            <span class="status-indicator syncing">
                                <i class="fa fa-refresh fa-spin"></i>
                                同步中
                                <span class="loading-dots"></span>
                            </span>
                        </div>
                        <div class="system-details">
                            <p><i class="fa fa-clock-o"></i> 最后同步时间: 2025-07-01 11:15</p>
                            <p><i class="fa fa-code-fork"></i> 数据版本: v2.3.5</p>
                            <p><i class="fa fa-tasks"></i> 同步进度: 65%</p>
                        </div>
                    </div>
                </div>

                <!-- ABP 系统 -->
                <div class="vertical-timeline-block fadeInUp">
                    <div class="vertical-timeline-icon blue-bg pulse">
                        <i class="fa fa-file-text"></i>
                    </div>
                    <div class="vertical-timeline-content">
                        <div class="system-header">
                            <h1 class="system-title">
                                <i class="fa fa-files-o"></i>
                                ABP 系统
                            </h1>
                            <span class="status-indicator syncing">
                                <i class="fa fa-refresh fa-spin"></i>
                                同步中
                                <span class="loading-dots"></span>
                            </span>
                        </div>
                        <div class="system-details">
                            <p><i class="fa fa-file"></i> 文档数量: 1,245份</p>
                            <p><i class="fa fa-hdd-o"></i> 存储空间: 245.6GB/500GB</p>
                            <p><i class="fa fa-exchange"></i> 数据传输: 45MB/s</p>
                        </div>
                    </div>
                </div>

                <!-- CEX 系统 -->
                <div class="vertical-timeline-block fadeInUp">
                    <div class="vertical-timeline-icon lazur-bg pulse">
                        <i class="fa fa-coffee"></i>
                    </div>
                    <div class="vertical-timeline-content">
                        <div class="system-header">
                            <h1 class="system-title">
                                <i class="fa fa-exchange"></i>
                                CEX 系统
                            </h1>
                            <span class="status-indicator syncing">
                                <i class="fa fa-refresh fa-spin"></i>
                                同步中
                                <span class="loading-dots"></span>
                            </span>
                        </div>
                        <div class="system-details">
                            <p><i class="fa fa-bar-chart"></i> 实时交易量: 1,245笔/分钟</p>
                            <p><i class="fa fa-tachometer"></i> 响应时间: 128ms</p>
                            <p><i class="fa fa-server"></i> 在线节点: 24/32</p>
                        </div>
                    </div>
                </div>

                <!-- AUP 系统（同步失败） -->
                <div class="vertical-timeline-block fadeInUp">
                    <div class="vertical-timeline-icon purple-bg">
                        <i class="fa fa-warning"></i>
                    </div>
                    <div class="vertical-timeline-content">
                        <div class="warning-badge">
                            <i class="fa fa-exclamation-triangle"></i>
                        </div>
                        <div class="system-header">
                            <h1 class="system-title" style="color: #7b4397;">
                                <i class="fa fa-exclamation-circle"></i>
                                AUP 系统
                            </h1>
                            <span class="status-indicator failed">
                                <i class="fa fa-times-circle"></i>
                                同步失败
                            </span>
                        </div>
                        <div class="system-details">
                            <p><i class="fa fa-clock-o"></i> 最后成功同步: 2025-06-30 18:30</p>
                            <p><i class="fa fa-code-fork"></i> 数据版本: v1.8.2</p>
                            <p><i class="fa fa-history"></i> 失败次数: 3次</p>
                        </div>
                        <div class="error-details">
                            <p><i class="fa fa-bug"></i> 错误代码: ERR_DB_CONNECTION_TIMEOUT</p>
                            <p><i class="fa fa-info-circle"></i> 数据库连接超时，请检查网络配置</p>
                        </div>
                        <button class="btn retry-btn">
                            <i class="fa fa-refresh"></i> 重试同步
                        </button>
                    </div>
                </div>

                <!-- AOP 系统（同步成功） -->
                <div class="vertical-timeline-block fadeInUp">
                    <div class="vertical-timeline-icon green-bg">
                        <i class="fa fa-check"></i>
                    </div>
                    <div class="vertical-timeline-content">
                        <div class="success-badge">
                            <i class="fa fa-check-circle"></i>
                        </div>
                        <div class="system-header">
                            <h1 class="system-title" style="color: #00b09b;">
                                <i class="fa fa-thumbs-up"></i>
                                AOP 系统
                            </h1>
                            <span class="status-indicator success">
                                <i class="fa fa-check-circle"></i>
                                同步成功
                            </span>
                        </div>
                        <div class="system-details">
                            <p><i class="fa fa-clock-o"></i> 完成时间: 2025-07-01 10:45</p>
                            <p><i class="fa fa-code-fork"></i> 数据版本: v3.1.0</p>
                            <p><i class="fa fa-database"></i> 同步数据量: 42.8GB</p>
                            <p><i class="fa fa-rocket"></i> 同步耗时: 12分35秒</p>
                        </div>
                        <button class="btn view-btn">
                            <i class="fa fa-line-chart"></i> 查看同步报告
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
        // 更新时间显示
          function updateTime() {
              const now = new Date();
              const hours = now.getHours().toString().padStart(2,  '0');
              const minutes = now.getMinutes().toString().padStart(2,  '0');
              document.querySelector('.date-info  .current-time').innerHTML =
                  `<i class="fa fa-calendar"></i> ${now.getFullYear()} 年${now.getMonth()+1} 月${now.getDate()} 日`;
              document.querySelector('.date-info  span:nth-child(2)').innerHTML =
                  `<i class="fa fa-clock-o"></i> 当前时间: ${hours}:${minutes}`;
          }

          // 初始更新时间
          updateTime();

          // 每分钟更新一次时间
          setInterval(updateTime, 60000);

          // 添加悬停效果
          document.querySelectorAll('.vertical-timeline-block').forEach(block  => {
              block.addEventListener('mouseenter',  function() {
                  this.style.transform  = 'translateY(-5px)';
                  this.style.boxShadow  = '0 15px 30px rgba(0,0,0,0.1)';
              });

              block.addEventListener('mouseleave',  function() {
                  this.style.transform  = '';
                  this.style.boxShadow  = '';
              });
          });

    document.querySelector('.start-sync').addEventListener('click',  () => {
        console.log(' 开始同步指令已发送');
         ys.ajax({
                url: '@Url.Content("~/ResultAnalysisManage/AnalysisInitialization/StartSyncCmdData")',
                type: 'get',
                success: function (obj) {
                    if (obj.Tag == 1) {
                        ys.msgSuccess(obj.Message);                    
                    }
                    else {
                        ys.msgError(obj.Message);
                    }
                }
         });
    });

    document.querySelector('.stop-sync').addEventListener('click',  () => {
        console.log(' 同步已暂停');
        
          ys.ajax({
                url: '@Url.Content("~/ResultAnalysisManage/AnalysisInitialization/StopSyncCmdData")',
                type: 'get',
                success: function (obj) {
                    if (obj.Tag == 1) {
                        ys.msgSuccess(obj.Message);
                    }
                    else {
                        ys.msgError(obj.Message);
                    }
                }
         });
        // 中断当前同步进程
    });

    document.querySelector('.resume-sync').addEventListener('click',  () => {
        console.log(' 继续同步操作');
        // 从中断点恢复同步
         ys.ajax({
                url: '@Url.Content("~/ResultAnalysisManage/AnalysisInitialization/DiversitySyncCmdData")',
                type: 'get',
                success: function (obj) {
                    if (obj.Tag == 1) {
                        ys.msgSuccess(obj.Message);
                    }
                    else {
                        ys.msgError(obj.Message);
                    }
                }
         });
    });

</script>

