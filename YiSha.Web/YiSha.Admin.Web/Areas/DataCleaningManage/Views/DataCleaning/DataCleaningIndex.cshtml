@{
    Layout = "~/Views/Shared/_Index.cshtml";
}
<div class="container-div">
    <div class="row">
        <div id="searchDiv" class="col-sm-12 search-collapse">
            <div class="select-list">
                <ul>
                    
                    <li>
                        系统： <span id="system" col="System"></span>
                    </li>
                    @* <li>
                        设备类型： <span id="deviceType" col="DeviceType"></span>
                    </li> *@
                    <li>
                        设备名称：<input id="deviceName" col="DeviceName" type="text" />
                    </li>
                    <li>
                        起始时间：<input id="startTime" col="StartTime" type="datetime-local" /> 
                    </li>
                    <li>
                        结束时间： <input id="endTime" col="EndTime" type="datetime-local" />
                    </li>
                    <li>
                        <a id="btnSearch" class="btn btn-primary btn-sm" onclick="searchGrid()"><i class="fa fa-search"></i>&nbsp;搜索</a>
                    </li>
                </ul>
            </div>
        </div>
        <div class="btn-group-sm hidden-xs" id="toolbar">
            <a id="SynPolicySteadyCondtion" class="btn btn-success">异常值判断（DBSCAN）</a>
            <a id="SynPolicyLogicSynEdState" class="btn btn-success">包络检测</a>
            <a id="SynPolicyLSEDelayState" class="btn btn-success">回归预测（XGBOOST）</a>
            <a id="SynPolicyMaxDeltState" class="btn btn-success">守恒过滤</a>
        </div>
        <div class="col-sm-12 select-table table-striped">
            <table id="gridTable" data-mobile-responsive="true"></table>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(function () {
        initGrid();
        $("#system").ysComboBox({
            data: top.getDataDict("FeattrueQuantitySysType"),
            key: "DictValue",
            value: "DictValue",
        });
        $("#deviceType").ysComboBox({
            data: top.getDataDict("FeattrueQuantitySysType"),
            key: "DictValue",
            value: "DictValue",
        });
    });

    function initGrid() {
        var queryUrl = '@Url.Content("~/DataCleaningManage/DataCleaning/GetPageListJson")';
        $('#gridTable').ysTable({
            url: queryUrl,
            columns: [
                { checkbox: true, visible: true },
                { field: 'Id', title: 'Id', visible: false },
                { field: 'System', title: '系统',
                     formatter: function (value, row, index) {
                         return $('#system').find('option:selected').text()
                     }
                },
                { field: 'Data_type', title: '设备类型' },

                { field: 'Column_name', title: '设备名称' },

                { field: 'Id', title: '时间',
                    formatter: function (value, row, index) {
                        if(value=='0')
                        {
                            return value;
                        }
                        else{
                        const beijingTime = new Date(value + 8 * 3600 * 1000);
                        return beijingTime.toISOString().replace('T', ' ').slice(0, 19);
                        }
                    }
                },
                { field: 'DataValue', title: '值' },

                { field: 'SanitizedValue', title: '清洗后的值' },
                { field: 'Remark', title: '备注' },
            ],
            queryParams: function (params) {
                var pagination = $('#gridTable').ysTable('getPagination', params);
                var queryString = $('#searchDiv').getWebControls(pagination);
                return queryString;
            }
        });
    }

    function searchGrid() {
        $('#gridTable').ysTable('search');
        resetToolbarStatus();
    }

    function showSaveForm(bAdd) {
        var id = 0;
        if (!bAdd) {
            var selectedRow = $('#gridTable').bootstrapTable('getSelections');
            if (!ys.checkRowEdit(selectedRow)) {
                return;
            }
            else {
                id = selectedRow[0].Id;
            }
        }
        ys.openDialog({
            title: id > 0 ? '编辑' : '添加',
            content: '@Url.Content("~/DataCleaningManage/DataCleaning/DataCleaningForm")' + '?id=' + id,
            width: '768px',
            height: '550px',
            callback: function (index, layero) {
                var iframeWin = window[layero.find('iframe')[0]['name']];
                iframeWin.saveForm(index);
            }
        });
    }

    function deleteForm() {
        var selectedRow = $('#gridTable').bootstrapTable('getSelections');
        if (ys.checkRowDelete(selectedRow)) {
            ys.confirm('确认要删除选中的' + selectedRow.length + '条数据吗？', function () {
                var ids = ys.getIds(selectedRow);
                ys.ajax({
                    url: '@Url.Content("~/DataCleaningManage/DataCleaning/DeleteFormJson")' + '?ids=' + ids,
                    type: 'post',
                    success: function (obj) {
                        if (obj.Tag == 1) {
                            ys.msgSuccess(obj.Message);
                            searchGrid();
                        }
                        else {
                            ys.msgError(obj.Message);
                        }
                    }
                });
            });
        }
    }
</script>
