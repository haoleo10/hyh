    // 定义能源分配数据更新函数
async function EnergyAllocation() {            
     $.ajax({
             url: '@Url.Content("~/ThermalPerformanceManage/AfficiencyAnalysis/Getittdb")',
         type: 'GET',
         dataType: 'json',
         success: function (obj) {
             console.log(obj);
             const dataMap = [
                 { id: "ks1", index: 0 },
                 { id: "ks2", index: 1 },
                 { id: "ks3", index: 2 },
                 { id: "ks5", index: 3 },
                 { id: "ks6", index: 4 },
                 { id: "ks15", index: 7 },
                 { id: "ks7", index: 5 },
                 { id: "ks8", index: 6 },
                 { id: "ks9", index: 8 },
                 { id: "ks10", index: 9 },
                 { id: "ks12", index: 10 },
                 { id: "ks13", index: 11 },
                 { id: "ks14", index: 12 },
                 { id: "ks11", index: 13 },
                 { id: "skn1", index: 14 }
             ];
            // 批量更新DOM元素
            dataMap.forEach(item => {
                try {
                      // 1. 安全获取数据并转换为数字
                      const rawValue = obj.Data.values[1][item.index];
                      const numValue = Number(rawValue);
  
                      // 2. 验证数字有效性
                      if (isNaN(numValue)) console.error('非数字类型数据');
  
                      // 3. 安全更新DOM
                      const targetElement = document.getElementById(item.id);
                      if (targetElement) {
                        targetElement.textContent = numValue.toFixed(2);
                      } 
                      else {
                       console.error(`未找到ID为"${item.id}"的元素`);
                      }
                    }
                 catch (error) {
                      // 错误捕获与降级处理
                      console.error('数据更新失败:', error.message);
                      const targetElement = document.getElementById(item.id);
                      if (targetElement) targetElement.textContent = '--'; // 显示占位符
                    }
               
            });

            // 固定值元素
            document.getElementById("ksh1").textContent = "无";
            document.getElementById("ks44").textContent = "无";
                
         }
     });
              
}

// 设置每秒执行一次
const intervalId = setInterval(EnergyAllocation, 4000);

// 如需停止定时器可调用: clearInterval(intervalId);
