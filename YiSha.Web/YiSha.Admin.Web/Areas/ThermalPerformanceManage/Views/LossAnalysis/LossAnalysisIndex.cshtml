
@{
    ViewData["Title"] = "LossAnalysisIndex";
    Layout = "~/Views/Shared/_Index.cshtml";
}

@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostingEnvironment
@section header {
 @*    <script src="~/lib/report/echarts/echarts.min.js"></script> *@
    <script src="~/lib/report/echarts/echarts.js"></script>
}

<div class="row">
    <div class="col-sm-10">
        <div class="tabs-container">
            <ul class="nav nav-tabs">             
                <li class="active">
                    <a data-toggle="tab" href="#tab-1" aria-expanded="true"> 柱状图显示</a>
                </li>
                <li class="">
                    <a data-toggle="tab" href="#tab-2" aria-expanded="false">列表对比显示</a>
                </li>
            </ul>
            <div class="tab-content">
                <div id="tab-1" class="tab-pane active">
                    <div class="panel-body">
                        
                        <div class="echarts" id="echarts-bar-chart"></div>

                    </div>
                </div>
                <div id="tab-2" class="tab-pane">
                    <div class="panel-body">
                        <div class="container-div">
                            <div class="row">
                                <div class="col-sm-12 select-table table-bordered">
                                    <table id="gridTable" data-mobile-responsive="true"></table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


        </div>
    </div>
</div>

<script type="text/javascript">
    $(function () {
      

        var barChart = echarts.init(document.getElementById("echarts-bar-chart"));
        var baroption = {
            title: {
                text: ''
            },
            tooltip: {
                trigger: 'axis'
            },
            legend: {
                data: ['设计值', '实时值']
            },
            grid: {
                x: 30,
                x2: 40,
                y2: 24
            },
            calculable: true,
            xAxis: [
                {
                    type: 'category',
                    data: ['总能量损失', '一回路能量损失份额', '疏水冷源损失', '汽轮机散热损失', '发电机损失', '机械损失']
                }
            ],
            yAxis: [
                {
                    type: 'value'
                }
            ],
            series: [
                {
                    name: '设计值',
                    type: 'bar',
                    data: [2.0, 4.9, 7.0, 23.2, 25.6, 76.7],
                    markPoint: {
                        data: [
                            { type: 'max', name: '最大值' },
                            { type: 'min', name: '最小值' }
                        ]
                    }
                },
                {
                    name: '实时值',
                    type: 'bar',
                    data: [2.6, 5.9, 9.0, 26.4, 28.7, 70.7, 175.6, 182.2, 48.7, 18.8, 6.0, 2.3],
                    markPoint: {
                        data: [
                            { name: '最高', value: 182.2, xAxis: 7, yAxis: 183, symbolSize: 18 },
                            { name: '最低', value: 2.3, xAxis: 11, yAxis: 3 }
                        ]
                    }                  
                }
            ]
        };
        barChart.setOption(baroption);
        window.onresize = barChart.resize;
        initGrid();
    });

    function initGrid() {
        var queryUrl = '@Url.Content("~/DemoManage/Table/GetPageListJson")';
        $('#gridTable').ysTable({
            url: queryUrl,
            showSearch: false,
            showRefresh: false,
            showToggle: false,
            showColumns: false,
            columns: [
                [
                    { title: '基本信息', align: 'center', colspan: 4 },
                    { title: '其他信息', align: 'center', colspan: 2 }
                ],
                [
                    { checkbox: true },
                    { field: 'Id', title: '用户ID' },
                    { field: 'RealName', title: '用户姓名' },
                    { field: 'Mobile', title: '用户手机' },
                    { field: 'Email', title: '邮箱' },
                    {
                        title: '操作',
                        align: 'center',
                        formatter: function (value, row, index) {
                            var actions = [];
                            actions.push('<a class="btn btn-success btn-xs" href="#"><i class="fa fa-edit"></i>编辑</a> ');
                            actions.push('<a class="btn btn-danger btn-xs" href="#"><i class="fa fa-remove"></i>删除</a>');
                            return actions.join('');
                        }
                    }
                ]
            ],
            queryParams: function (params) {
                var pagination = $('#gridTable').ysTable('getPagination', params);
                var queryString = $('#searchDiv').getWebControls(pagination);
                return queryString;
            }
        });
    }
</script>