@{
    Layout = "~/Views/Shared/_Index.cshtml";
 }
<div class="container-div">
    <div class="row">
        <div id="searchDiv" class="col-sm-12 search-collapse" style="display:none;">
            <div class="select-list">
                <ul>
                    <li>
                        Param_alerts_Id：<input id="param_alerts_Id" col="Param_alerts_Id" type="text" />
                    </li>
                    <li>
                        <a id="btnSearch" class="btn btn-primary btn-sm" onclick="searchGrid()"><i class="fa fa-search"></i>&nbsp;搜索</a>
                    </li>
                </ul>
            </div>
        </div>
        <div class="btn-group-sm hidden-xs" id="toolbar" style="display:none;">
            <a id="btnAdd" class="btn btn-success" onclick="showSaveForm(true)"><i class="fa fa-plus"></i> 新增</a>
            <a id="btnEdit" class="btn btn-primary disabled" onclick="showSaveForm(false)"><i class="fa fa-edit"></i> 修改</a>
            <a id="btnDelete" class="btn btn-danger disabled" onclick="deleteForm()"><i class="fa fa-remove"></i> 删除</a>
        </div>
        <div class="col-sm-12 select-table table-striped">
            <table id="gridTable" data-mobile-responsive="true"></table>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(function () {
        initGrid();
    });

    function initGrid() {
        var queryUrl = '@Url.Content("~/ThreeDimensions‌Manage/param_Tieba/GetPageListJson")';
        $('#gridTable').ysTable({
            showColumns: false,                  // 是否显示所有的列（选择显示的列）
            showRefresh: false,                  // 是否显示刷新按钮
            showToggle: false,                   // 是否显示详细视图和列表视图的切换按钮           
            pageSize: 25,                       // 每页的记录行数（*）

            url: queryUrl,
            columns: [
                { checkbox: true, visible: true },
                { field: 'Id', title: 'Id', visible: false },
                { field: 'Param_alerts_Id', title: 'Param_alerts_Id',visible: false },
                { field: 'Name', title: '贴名' },
                { field: 'Param_Key', title: '警报参数' },
                { field: 'Param_Value', title: '值(3k)' },
                { field: 'Param_Value1', title: '值(kns)' },
                { field: 'Source_SYS', title: '系统' },
                { field: 'Content', title: '内容' },
                { field: 'BaseCreateTime', title: '发帖时间' },
                {
                        title: '操作',
                        align: 'center',
                        formatter: function (value, row, index) {
                            var actions = [];
                            actions.push('<a class="btn btn-success btn-xs" onclick="PINGLV(\''+row.Id+'\')"><i class="fa fa-edit"></i>评论</a> ');
                            return actions.join('');
                        }
                },
            ],
            queryParams: function (params) {
                var pagination = $('#gridTable').ysTable('getPagination', params);
                var queryString = $('#searchDiv').getWebControls(pagination);
                return queryString;
            }
        });
    }

    function searchGrid() {
        $('#gridTable').ysTable('search');
        resetToolbarStatus();
    }

    function PINGLV(Id)
    {

        ys.openDialog({
            title: '评论详情',
            content: '@Url.Content("~/ThreeDimensions‌Manage/ParamComment/ToParamCommentIndex")' + '?id=' + Id,
            width: '1300px',
            height: '800px',
            btn:[],
            callback: function (index, layero) {
            
            }
        });
       // window.location.href =  '@Url.Content("~/ThreeDimensions‌Manage/ParamComment/ToParamCommentIndex")' + '?id=' + Id;
    
    
    }
    function showSaveForm(bAdd) {
        var id = 0;
        if (!bAdd) {
            var selectedRow = $('#gridTable').bootstrapTable('getSelections');
            if (!ys.checkRowEdit(selectedRow)) {
                return;
            }
            else {
                id = selectedRow[0].Id;
            }
        }
        ys.openDialog({
            title: id > 0 ? '编辑' : '添加',
            content: '@Url.Content("~/ThreeDimensions‌Manage/param_Tieba/param_TiebaForm")' + '?id=' + id,
            width: '768px',
            height: '550px',
            callback: function (index, layero) {
                var iframeWin = window[layero.find('iframe')[0]['name']];
                iframeWin.saveForm(index);
            }
        });
    }

    function deleteForm() {
        var selectedRow = $('#gridTable').bootstrapTable('getSelections');
        if (ys.checkRowDelete(selectedRow)) {
            ys.confirm('确认要删除选中的' + selectedRow.length + '条数据吗？', function () {
                var ids = ys.getIds(selectedRow);
                ys.ajax({
                    url: '@Url.Content("~/ThreeDimensions‌Manage/param_Tieba/DeleteFormJson")' + '?ids=' + ids,
                    type: 'post',
                    success: function (obj) {
                        if (obj.Tag == 1) {
                            ys.msgSuccess(obj.Message);
                            searchGrid();
                        }
                        else {
                            ys.msgError(obj.Message);
                        }
                    }
                });
            });
        }
    }
</script>
