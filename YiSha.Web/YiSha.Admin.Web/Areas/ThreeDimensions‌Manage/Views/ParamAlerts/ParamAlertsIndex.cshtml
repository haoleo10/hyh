@{
    Layout = "~/Views/Shared/_Index.cshtml";
}

<div class="container-div">
    <div class="row">
        <div id="searchDiv" class="col-sm-12 search-collapse" style="display:none;">
            <div class="select-list">
                <ul>
                    <li>
                        Name：<input id="name" col="Name" type="text" />
                    </li>
                    <li>
                        <a id="btnSearch" class="btn btn-primary btn-sm" onclick="searchGrid()"><i class="fa fa-search"></i>&nbsp;搜索</a>
                    </li>
                </ul>
            </div>
        </div>
        <div class="btn-group-sm hidden-xs" id="toolbar" style="display:none;">
            <a id="btnAdd" class="btn btn-success" onclick="showSaveForm(true)"><i class="fa fa-plus"></i> 新增</a>
            <a id="btnEdit" class="btn btn-primary disabled" onclick="showSaveForm(false)"><i class="fa fa-edit"></i> 修改</a>
            <a id="btnDelete" class="btn btn-danger disabled" onclick="deleteForm()"><i class="fa fa-remove"></i> 删除</a>
        </div>
        <div class="col-sm-12 select-table table-striped">
            <table id="gridTable" data-mobile-responsive="true"></table>
        </div>
    </div>
</div>

<script type="text/javascript">
    var AlarmLayer = ys.request("AlarmLayer");
    var SYS = ys.request("SYS");


    function TiebaGet(ParaId)
    {
        console.log(ParaId);
        ys.openDialog({
            title: '上传贴吧',
            content: '@Url.Content("~/ThreeDimensions‌Manage/param_Tieba/param_TiebaForm")' + '?id=' + ParaId,
            width: '768px',
            height: '550px',
            callback: function (index, layero) {
                var iframeWin = window[layero.find('iframe')[0]['name']];
                iframeWin.saveForm(index);
            }
        });

    }

    $(function () {
        initGrid();
    });

    var gridTimer = null;
    var thresholdMap = {};

    function initGrid() {
        $('#gridTable').ysTable({
            url: '',
            showSearch: false,
            showRefresh: false,
            showToggle: false,
            showColumns: false,
            pagination: false,
            columns: [
                { checkbox: true, visible: false },
                { field: 'Id', title: 'Id', visible: false },
                { field: 'Name', title: '名称',visible: false },
                { field: 'Param_Key', title: '点名' ,width:"20%"},
                { field: 'Param_Value', title: '值(3k)' ,width:"20%"},
                { field: 'Param_Value1', title: '值(kns)' ,width:"20%"},
                { field: 'Source_SYS', title: '系统名',width:"20%" },
                { field: 'BaseCreateTime', title: '报警时间',width:"20%", sortable: false},
                { field: 'Remark', title: '备注' ,visible: false},
                 {
                        title: '操作',
                        align: 'center',
                        width:"20%",
                        formatter: function (value, row, index) {
                            console.log(value);
                            console.log(row);
                            console.log(index);

                            var actions = [];
                            actions.push('<a class="btn btn-success btn-xs" onclick="TiebaGet(\''+row.Id+'\')"><i class="fa fa-edit"></i>上传贴吧</a> ');
                            return actions.join('');
                        }
                    },
            ]
        });

        loadGridData();
        gridTimer = setInterval(loadGridData, 1000);
        $(document).on('input', '.threshold-input', function () {
            var id = $(this).data('id');
            thresholdMap[id] = $(this).val();
        });
    }

    function loadGridData() {

        var queryUrl = '@Url.Content("~/ThreeDimensions‌Manage/ParamAlerts/GetPageListJson?AlarmLayer=")'+ AlarmLayer + '&SYS='+ SYS;

        $('.threshold-input').each(function () {
            var id = $(this).data('id');
            thresholdMap[id] = $(this).val();
        });

        $.ajax({
            url: queryUrl,
            type: 'GET',
            dataType: 'json',
            success: function (res) {
                // API 返回的是 res.Data，不是 res.rows
                $('#gridTable').bootstrapTable('load', res.Data || res.rows || res);
            },
            error: function () {
                console.error('数据加载失败');
            }
        });
        console.log("123");
    }

    $(window).on('beforeunload', function () {
        if (gridTimer) {
            clearInterval(gridTimer);
            gridTimer = null;
        }
    });
</script>
