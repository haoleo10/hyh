@using YiSha.Util
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostingEnvironment
@{
    Layout = "~/Views/Shared/_Index.cshtml";
}


<body>
    <!-- 表单配置区 -->
    <div class="config-list" id="configList">
        <!-- 配置项将通过 JavaScript 动态生成 -->
    </div>

    <script>
        //接收参数 DataType 0 实时数据 1 历史数据  SYS 系统名
        var DataType = ys.request("DataType");

        var SYS = ys.request("SYS");

        var StartTime = ys.request("StartTime") || "";

        var EndTime = ys.request("EndTime") || "";

        var Multiple = ys.request("Multiple") || "";

        var Stop = ys.request("Stop") || "";


        // function addOneSecond(timeStr) {
        //     if (!timeStr) return timeStr;
        //     //删除最后一个冒号后面的所有垃圾（不管几位）
        //     let cleanTime = timeStr.trim().split(':').slice(0, 3).join(':');
        //     // 标准时间解析
        //     let date = new Date(cleanTime);
        //     if (isNaN(date.getTime())) {
        //         date = new Date();
        //     }
        //     // +1秒
        //     date.setSeconds(date.getSeconds() + Number(Multiple));

        //     // 格式化
        //     let y = date.getFullYear();
        //     let M = String(date.getMonth() + 1).padStart(2, '0');
