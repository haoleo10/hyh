@using YiSha.Util
@{
    Layout = "~/Views/Shared/_Index.cshtml";
}

@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostingEnvironment
@section header {
    @BundlerHelper.Render(HostingEnvironment.ContentRootPath, Url.Content("~/lib/report/echarts/echarts.min.js"))
}
<div class="container-div">
    <div class="row">
        <div class="echarts" id="echarts-line-chart" style="margin-bottom:20px;"></div>
        <div class="col-sm-12 select-table table-striped">
            <table id="gridTable" data-mobile-responsive="true"></table>
        </div>
    </div>
</div>

<script type="text/javascript">
    var Device = ys.request("Device");  
    $(function () {
        var eChartsData;
        $.ajax({
            url: '@Url.Content("~/FeatrueQuantityManage/FeatrueQuantity/GetEchartDataListJsonss?Device=")'+ Device,
            type: 'GET',
            dataType: 'json',
            success: function (obj) {   
                eChartsData=obj;
                console.log(eChartsData);
                // 基于准备好的dom，初始化echarts实例
        var lineChart = echarts.init(document.getElementById("echarts-line-chart"));
        var lineoption = {
            title: {
                text: '趋势图'
            },
            tooltip: {
                trigger: 'axis'
            },
            legend: {
                data: ['计算值', '参考值']
            },
            grid: {
                x: 40,
                x2: 40,
                y2: 24
            },
            calculable: true,
            xAxis: [
                {
                    type: 'category',
                    boundaryGap: false,
                    data: eChartsData.column_names,
                }
            ],
            yAxis: [
                {
                    type: 'value',
                    // axisLabel: {
                    //     formatter: '{value} °C'
                    // }
                }
            ],
            series: [
                {
                    name: '计算值',
                    type: 'line',
                    data: eChartsData.values[0],
                    markPoint: {
                        data: [
                            { type: 'max', name: '最大值' },
                            { type: 'min', name: '最小值' }
                        ]
                    },
                    markLine: {
                        data: [
                            { type: 'average', name: '平均值' }
                        ]
                    }
                },
                {
                    name: '参考值',
                    type: 'line',
                    data: [1, -2, 2, 5, 3, 2, 0],
                    markPoint: {
                        data: [
                            { name: '周最低', value: -2, xAxis: 1, yAxis: -1.5 }
                        ]
                    },
                    markLine: {
                        data: [
                            { type: 'average', name: '平均值' }
                        ]
                    }
                }
            ]
        };

        lineChart.setOption(lineoption);
        $(window).resize(lineChart.resize);
            }
        });       
        initGrid();
    });

    function initGrid() {
        var queryUrl = '@Url.Content("~/FeatrueQuantityManage/FeatrueQuantity/GetEchartDataListJsons?Device=")'+ Device;
        $('#gridTable').ysTable({
            url: queryUrl,
            showColumns: false,                  // 是否显示所有的列（选择显示的列）
            showRefresh: false,                  // 是否显示刷新按钮
            showToggle: false,                   // 是否显示详细视图和列表视图的切换按钮
            columns: [
                { checkbox: true, visible: true },
                { field: 'Id', title: '时间', visible: true,
                     formatter: function (value, row, index) {
                            if(value=='0')
                            {
                                return value;
                            }
                            else{
                            const beijingTime = new Date(value + 8 * 3600 * 1000);
                            return beijingTime.toISOString().replace('T', ' ').slice(0, 19);
                            }
                     }
                },
                { field: 'Column_name', title: '设备名称', sortable: true },
                { field: 'Data_type', title: '类型', sortable: true },
                { field: 'DataValue', title: '计算值' },              
                { field: 'Remark', title: '备注' },
            ],
            queryParams: function (params) {
                var pagination = $('#gridTable').ysTable('getPagination', params);
                var queryString = $('#searchDiv').getWebControls(pagination);
                return queryString;
            }
        });
    }
</script>

